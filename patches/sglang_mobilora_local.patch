diff --git a/python/sglang/srt/mobilora.py b/python/sglang/srt/mobilora.py
new file mode 100644
index 0000000..07c44fe
--- /dev/null
+++ b/python/sglang/srt/mobilora.py
@@ -0,0 +1,54 @@
+from __future__ import annotations
+
+import math
+import time
+
+
+APP_STATE_SCORES = {
+    "foreground": 1.0,
+    "background": 0.4,
+    "killed": 0.0,
+}
+
+
+def normalize_extra_key(
+    extra_key: str | None,
+    lora_id: str | None,
+    allow_cross_adapter_reuse: bool,
+) -> str | None:
+    if lora_id is None:
+        return extra_key
+    if allow_cross_adapter_reuse:
+        return extra_key or ""
+    return (extra_key or "") + lora_id
+
+
+def state_score(app_state: str | None) -> float:
+    if app_state is None:
+        return APP_STATE_SCORES["killed"]
+    return APP_STATE_SCORES.get(app_state.lower(), APP_STATE_SCORES["killed"])
+
+
+def compute_utility(
+    *,
+    app_state: str | None,
+    last_access_time: float,
+    token_len: int,
+    state_lambda: float,
+    recency_lambda: float,
+    length_lambda: float,
+    now: float | None = None,
+) -> float:
+    current_time = time.monotonic() if now is None else now
+    age = max(current_time - last_access_time, 0.0)
+    recency_term = 1.0 / (1.0 + age)
+    length_term = math.log1p(max(token_len, 0))
+    return (
+        state_lambda * state_score(app_state)
+        + recency_lambda * recency_term
+        + length_lambda * length_term
+    )
+
+
+def utility_to_priority(utility: float, *, scale: int = 1000) -> int:
+    return int(round(utility * scale))
